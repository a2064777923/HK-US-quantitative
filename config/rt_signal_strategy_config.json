{
  "schema": "rt_signal_strategy_config_v1",
  "version": "v5.8-factor-conflict-discipline-20260620",
  "description": "Realtime v5.8 keeps completed daily OHLCV as the stable technical base while using current-session quote evidence only as a provisional overlay. BUY execution candidates still fail closed to WATCH when same-market realtime breadth context is missing/insufficient or risk-off, large positive same-session moves require at least two non-momentum supporting factor families, and any directional execution candidate with more than one opposing factor family is downgraded to diagnostic WATCH. Noisy or underperforming BUY triggers remain diagnostic, downgraded SELL diagnostics stay summary-only, same-scan execution candidate ranking is unchanged, and Hermes/readiness/liquidity/RR/intake gates remain unchanged.",
  "signal_cooldown_seconds": 1800,
  "volume_anomaly_ratio": 3.0,
  "confirmation_thresholds": {
    "BUY": {
      "min_full_score": 0.45
    },
    "SELL": {
      "max_full_score": -0.45
    }
  },
  "confirmation_requirements": {
    "BUY": {
      "min_supporting_factor_count": 2,
      "max_opposing_factor_count": 1
    },
    "SELL": {
      "min_supporting_factor_count": 2,
      "max_opposing_factor_count": 1
    }
  },
  "momentum_breakout_model": {
    "enabled": true,
    "large_move_buy_pct": 5.0,
    "large_move_sell_enabled": false,
    "same_session_momentum_pct": 3.0,
    "same_session_score_delta": 0.4,
    "bollinger_buy_min_change_pct": 2.0,
    "bollinger_buy_min_score": 0.8,
    "bollinger_buy_min_supporting_factors": 3,
    "large_move_buy_min_non_momentum_factors": 2
  },
  "risk_model": {
    "atr_stop_multiple": 2.0,
    "atr_take_profit_multiple": 3.0,
    "min_rr_ratio": 1.2
  },
  "market_breadth_model": {
    "enabled": true,
    "block_new_buy_in_risk_off": true,
    "block_new_buy_when_context_missing": true,
    "min_sample_size": 10,
    "risk_off_max_advancer_pct": 35.0,
    "risk_off_min_decliner_pct": 50.0,
    "risk_off_max_avg_change_pct": -0.6
  },
  "realtime_alignment": {
    "block_buy_when_change_pct_below": 0.0
