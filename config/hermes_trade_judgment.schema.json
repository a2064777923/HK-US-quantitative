{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a2064777923/HK-US-quantitative/hermes_trade_judgment.schema.json",
  "title": "Hermes Trade Judgment",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "required_context_review": {
      "type": "object",
      "additionalProperties": true,
      "description": "Approve/reduce must set every required context review flag to true. This mirrors hermes_judgment_audit_report.REQUIRED_CONTEXT_REVIEW_FLAGS.",
      "required": [
        "technical_signal_reviewed",
        "portfolio_risk_reviewed",
        "strategy_evidence_reviewed",
        "data_health_reviewed",
        "execution_readiness_reviewed",
        "market_context_reviewed",
        "intraday_context_reviewed",
        "external_market_context_reviewed",
        "event_catalysts_reviewed",
        "event_catalyst_signals_reviewed",
        "market_sentiment_reviewed",
        "fundamentals_context_reviewed",
        "source_reliability_reviewed",
        "simulation_performance_reviewed",
        "cron_wiring_reviewed"
      ],
      "properties": {
        "technical_signal_reviewed": {"const": true},
        "portfolio_risk_reviewed": {"const": true},
        "strategy_evidence_reviewed": {"const": true},
        "data_health_reviewed": {"const": true},
        "execution_readiness_reviewed": {"const": true},
        "market_context_reviewed": {"const": true},
        "intraday_context_reviewed": {"const": true},
        "external_market_context_reviewed": {"const": true},
        "event_catalysts_reviewed": {"const": true},
        "event_catalyst_signals_reviewed": {"const": true},
        "market_sentiment_reviewed": {"const": true},
        "fundamentals_context_reviewed": {"const": true},
        "source_reliability_reviewed": {"const": true},
        "simulation_performance_reviewed": {"const": true},
        "cron_wiring_reviewed": {"const": true},
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  "required": [
    "schema",
    "packet_id",
    "signal_id",
    "decision",
    "confidence",
    "reviewed_at",
    "supporting_factors",
    "opposing_factors",
    "risk_notes"
  ],
  "properties": {
    "schema": {
      "const": "hermes_trade_judgment_v1"
    },
    "signal_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "description": "Copy from hermes_signal_review_packet_v1.packet_id."
    },
    "decision": {
      "type": "string",
      "enum": ["approve", "reject", "reduce", "hold"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "string"
    },
    "expiry_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "max_quantity": {
      "type": "integer",
      "minimum": 1,
      "description": "Required when decision is reduce."
    },
    "supporting_factors": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "opposing_factors": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "risk_notes": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "market_context": {
      "type": "object",
      "description": "Optional snapshot or summary of market_context_report used by Hermes during review."
    },
    "market_regime_exception": {
      "type": "boolean",
      "description": "Set true only when approving or reducing a new BUY despite risk_off market_context."
    },
    "market_regime_exception_reason": {
      "type": "string",
      "minLength": 20,
      "description": "Specific reason for overriding risk_off breadth context."
    },
    "portfolio_context": {
      "type": "object"
    },
    "strategy_evidence": {
      "type": "object",
      "description": "Optional snapshot or summary of rt_signal_outcome_report used by Hermes during review."
    },
    "context_review": {
      "type": "object",
      "description": "Required for approve/reduce. Every required *_reviewed flag must be true."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"const": "reduce"}}
      },
      "then": {
        "required": ["max_quantity", "context_review"],
        "properties": {
          "context_review": {"$ref": "#/$defs/required_context_review"}
        }
      }
    },
    {
      "if": {
        "properties": {"decision": {"const": "approve"}}
      },
      "then": {
        "required": ["context_review"],
        "properties": {
          "context_review": {"$ref": "#/$defs/required_context_review"}
        }
      }
    },
    {
      "if": {
        "properties": {"market_regime_exception": {"const": true}}
      },
      "then": {
        "required": ["market_regime_exception_reason"]
      }
    }
  ]
}
