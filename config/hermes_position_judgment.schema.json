{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a2064777923/HK-US-quantitative/hermes_position_judgment.schema.json",
  "title": "Hermes Position Review Judgment",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "required_context_review": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "position_context_reviewed",
        "portfolio_risk_reviewed",
        "market_context_reviewed",
        "external_context_reviewed",
        "intraday_context_reviewed"
      ],
      "properties": {
        "position_context_reviewed": {"const": true},
        "portfolio_risk_reviewed": {"const": true},
        "market_context_reviewed": {"const": true},
        "external_context_reviewed": {"const": true},
        "intraday_context_reviewed": {"const": true},
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  "required": [
    "schema",
    "packet_id",
    "review_id",
    "portfolio_id",
    "role",
    "symbol",
    "decision",
    "confidence",
    "reviewed_at",
    "advisory_only",
    "submits_orders",
    "supporting_factors",
    "opposing_factors",
    "risk_notes"
  ],
  "properties": {
    "schema": {
      "const": "hermes_position_judgment_v1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "description": "Copy from hermes_signal_review_packet_v1.packet_id."
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "description": "Copy from position_review.items[].review_id."
    },
    "portfolio_id": {
      "type": "integer"
    },
    "role": {
      "type": "string",
      "enum": ["user", "simulation"]
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": ["hold", "watch", "reduce", "exit", "trail_stop"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "string"
    },
    "expiry_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "advisory_only": {
      "type": "boolean",
      "description": "Must be true; this judgment must not submit orders."
    },
    "submits_orders": {
      "type": "boolean",
      "description": "Must be false; position judgments are advisory review artifacts only."
    },
    "max_exit_quantity": {
      "type": "number",
      "minimum": 0,
      "description": "Optional advisory size cap for reduce or exit decisions."
    },
    "supporting_factors": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "opposing_factors": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "risk_notes": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "context_review": {
      "$ref": "#/$defs/required_context_review",
      "description": "Required by hermes_position_judgment_audit_report.py when the reviewed position_review item includes context_digest."
    },
    "position_attention_acknowledged": {
      "type": "boolean",
      "description": "Set true when the reviewed position_review.items[].context_digest.position_attention[] is non-empty."
    },
    "position_attention_codes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "The position_review.items[].context_digest.position_attention[] codes Hermes explicitly considered."
    },
    "position_attention_notes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Specific notes explaining how holding-specific attention items affected hold/watch/reduce/exit/trail-stop advice."
    },
    "position_attention_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "effect", "decision_impact"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "One reviewed position_review.items[].context_digest.position_attention[] code."
          },
          "effect": {
            "type": "string",
            "minLength": 1,
            "description": "Specific holding-risk interpretation for this attention code."
          },
          "decision_impact": {
            "type": "string",
            "minLength": 1,
            "description": "How this attention code affected hold/watch/reduce/exit/trail-stop advice."
          }
        },
        "additionalProperties": true
      },
      "description": "One object per reviewed position_attention code, required by audit when position_attention is non-empty."
    },
    "follow_up": {
      "type": "array",
      "items": {"type": "string"}
    },
    "market_context": {
      "type": "object"
    },
    "portfolio_context": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"enum": ["reduce", "exit"]}}
      },
      "then": {
        "properties": {
          "max_exit_quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {"advisory_only": {"const": false}}
      },
      "then": false
    },
    {
      "if": {
        "properties": {"submits_orders": {"const": true}}
      },
      "then": false
    }
  ]
}
